# Server Environment
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# Paste your MongoDB Atlas connection string or remote cluster URI:
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/RSGIFTS?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/RSGIFTS?retryWrites=true&w=majority
MONGO_DB_NAME=RSGIFTS

# JWT Authentication
JWT_SECRET=rs_gifts_super_secret_jwt_key_2026_secure
JWT_EXPIRES_IN=7d

# Allowed Frontend Origins (CORS)
CLIENT_ADMIN_URL=http://localhost:3000
CLIENT_STOREFRONT_URL=http://localhost:5173

# Optional: Cloudinary Configuration (Can also be set dynamically in Admin Settings)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
