# Server Environment
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/RSGIFTS?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/RSGIFTS?retryWrites=true&w=majority
MONGO_DB_NAME=RSGIFTS

# JWT Authentication
JWT_SECRET=rs_gifts_super_secret_jwt_key_2026_secure
JWT_EXPIRES_IN=7d

# Allowed Frontend Origins (CORS)
CLIENT_ADMIN_URL=http://localhost:3000
CLIENT_STOREFRONT_URL=http://localhost:5173

# Optional: Cloudinary Configuration (Can also be set dynamically in Admin Settings)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email SMTP Configuration (For Password Reset OTP & Notifications)
# Example for Gmail: EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587, EMAIL_USER=you@gmail.com, EMAIL_PASS=16_char_app_password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="RS Gifts <no-reply@rsgifts.com>"
